# Скопировать в /etc/m5-geo/panel.env, вписать токен, chmod 600.
# Токен API панели RemnaWave (роль API). Хранится ТОЛЬКО на сервере панели.
M5VPN_API_TOKEN=ВПИШИ_ТОКЕН_СЮДА
M5VPN_API_URL=https://m5vpn.com/rw/api
# База раздачи гео через CDN (по умолчанию совпадает):
M5_GEO_CDN=https://s.m5service.name/geo
